# Frontend configuration — PUBLIC values only. Never put secrets here (Vite exposes every VITE_* variable to browsers).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# API base: "/api" when served by the edge Worker (same origin), or the API Worker URL.
VITE_API_BASE_URL=/api
VITE_APP_URL=http://localhost:5173
